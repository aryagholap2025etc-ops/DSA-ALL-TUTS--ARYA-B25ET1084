SUBSTRING
#include <stdio.h>

int main()
{
    char str[100];
    int start, n, i;

    printf("Enter a string: ");
    scanf("%s", str);

    printf("Enter starting position: ");
    scanf("%d", &start);

    printf("Enter length: ");
    scanf("%d", &n);

    printf("Substring = ");

    for(i = start; i < start + n && str[i] != '\0'; i++)
    {
        printf("%c", str[i]);
    }

    return 0;
}
PALINDROME
#include <stdio.h>
#include <string.h>

int main()
{
    char str[100], rev[100];
    int i, len;

    printf("Enter a string: ");
    scanf("%s", str);

    len = strlen(str);

    for(i = 0; i < len; i++)
    {
        rev[i] = str[len - 1 - i];
    }

    rev[len] = '\0';

    if(strcmp(str, rev) == 0)
        printf("String is Palindrome");
    else
        printf("String is Not Palindrome");

    return 0;
}
